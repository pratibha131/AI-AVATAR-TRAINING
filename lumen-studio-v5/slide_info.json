    "paragraphs": [
      {
        "text": "MoS GURU",
        "shape_id": 8,
        "para_idx": 0
      },
      {
        "text": "What is Artificial Intelligence (AI) ?",
        "shape_id": 9,
        "para_idx": 0
      },
      {
        "text": "Artificial Intelligence (AI) is technology that enables machines and software to learn, think, analyze, and make decisions like humans.",
        "shape_id": 7,
        "para_idx": 0
      },
      {
        "text": "AI helps people understand information, generate ideas, automate routine work, and make everyday tasks easier.",
        "shape_id": 7,
        "para_idx": 1
      },
      {
        "text": "Instead of replacing people, AI helps us become more productive.",
        "shape_id": 7,
        "para_idx": 2
      }
    ],
    "notes": ""
  },
